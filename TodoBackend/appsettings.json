{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SeedDemoData": false,
  "Session": {
    "LifetimeDays": 30
  },
  "RateLimit": {
    "AuthenticationRequestsPerMinute": 10,
    "GraphQLRequestsPerMinute": 120
  },
  "AllowedHosts": "*"
}
